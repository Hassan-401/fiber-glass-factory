{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "souq-masreya-fiberglass",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "souq-masreya-fiberglass",
      "database_id": "057629b0-420e-4c6d-89c9-c145d6337b91"
    }
  ],
  "observability": { "enabled": true }
}
