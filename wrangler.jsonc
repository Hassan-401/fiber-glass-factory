{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "souq-masreya-fiberglass",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // الـ Worker بيشتغل على كل الطلبات عشان تحويل www يشتغل على الصفحات كمان
    "run_worker_first": true
  },
  // الدومين المخصص — Cloudflare بيعمل سجلات DNS وشهادة SSL تلقائياً
  "routes": [
    { "pattern": "souq-masreya-fiberglass.com", "custom_domain": true },
    { "pattern": "www.souq-masreya-fiberglass.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "souq-masreya-fiberglass",
      "database_id": "057629b0-420e-4c6d-89c9-c145d6337b91"
    }
  ],
  "observability": { "enabled": true }
}
